.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.DS_Store
.pytest_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Keep reproducible model-comparison results even if a parent ignores CSV files.
!reports/metrics.csv

# Local configuration and cloud output
.env
.aws/
mlruns/
outputs/
