data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# The selected model is small enough to ship with the API (<100 MB).
# CI may additionally create temporary/experimental artifacts.
models/*.part
models/*.tmp

