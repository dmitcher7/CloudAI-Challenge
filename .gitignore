# Virtual environment
venv/
venv*
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Grote databestanden en opgeslagen modellen (GitHub limiet is 100MB!)
*.csv
*.log
*.zip
*.data
*.parquet
*.pkl
# ...behalve de modellen die naar de VM gaan (zie .github/workflows/deploy-api.yml)
!deploy/*/*.pkl
# ...en de kleine, voorbereide Citi Bike-modeltabel (2,3 MB): modellen hertrainen zonder 8,7 GB te downloaden
!citi_bike/Kobe/data/model_table.parquet
!citi_bike/Kobe/data/2024/model_table.parquet
# Tussenresultaten per bronbestand van 01_download (worden opnieuw gemaakt)
citi_bike/Kobe/data/_*/
*.h5

# Omgevingsvariabelen en geheime API keys
.env
